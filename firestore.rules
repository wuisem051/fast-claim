rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Configuración Global y Token del Bot
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Borradores y Publicaciones de Telegram (Permiso para crear y leer borradores)
    match /broadcast_drafts/{draftId} {
      allow read, write: if true; // O: if request.auth != null;
    }

    // Usuarios
    match /users/{userId} {
      allow read, create, update: if true;
      allow delete: if request.auth != null;
    }

    // Tareas
    match /tasks/{taskId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /user_tasks/{userTaskId} {
      allow read, write: if true;
    }

    // Retiros
    match /withdrawals/{withdrawalId} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }

    // Referidos y Comisiones
    match /referrals/{refId} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }

    match /referral_commissions/{commId} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }

    // Sesiones y Eventos
    match /user_sessions/{sessionId} {
      allow read, write: if true;
    }

    match /claim_events/{eventId} {
      allow read, write: if true;
    }

    // Regla de respaldo
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
